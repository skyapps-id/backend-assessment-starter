# Environment Variables Example
# Copy this file to .env and set your own values

# JWT Secret (REQUIRED)
# Must be set for the application to start
# Use a secure random string (minimum 32 characters)
JWT_SECRET=your-secure-random-secret-here

# Database Path (OPTIONAL)
# Defaults to notes.db in current directory
# DB_PATH=notes.db

# Port (OPTIONAL)  
# Defaults to 3000
# PORT=3000

# CORS Origins (OPTIONAL)
# Comma-separated list of allowed origins
# Defaults to http://localhost:3000,http://localhost:5173
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Node Environment (OPTIONAL)
# development or production
# development = shows error stack traces
# production = hides error stack traces
# NODE_ENV=development